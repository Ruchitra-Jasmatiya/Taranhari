# Copy to .env for local use (never commit .env). On Vercel set these in Settings -> Environment Variables.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=any-long-random-text-32-characters-or-more
# Upstash Redis (free) - added automatically when you connect it from Vercel -> Storage
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
